.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Excel files with real physician data (keep only repo samples if desired)
*.xlsx
*.xls

# Sensitive config — the real file has the API key; only the template is committed
scheduler/config/scheduler_config.yaml

# Sensitive config — has the ByteBloc security token and org ID mappings;
# only bytebloc_template.yaml is committed
scheduler/config/bytebloc.yaml

# Sensitive config — has the sending mailbox's app password;
# only email_template.yaml is committed
scheduler/config/email.yaml
scheduler/config/sked.yaml

# Sensitive config — has the Google service-account key path and the
# shared master-schedule Drive folder id; only google_sheets_template.yaml
# is committed. The service-account JSON key itself is also gitignored.
scheduler/config/google_sheets.yaml
scheduler/config/google_service_account.json

# Real physician names, aliases, and personal scheduling restrictions —
# only physicians_template.yaml is committed. (This was tracked in git
# until 2026-09-11; still present in history — see the pending
# history-purge decision before treating past commits as clean.)
scheduler/config/physicians.yaml

# Local certificates and credentials (never push)
certs/

[
  {
    "label": "Backend: run FastAPI server",
    "command": ".venv/bin/python3",
    "args": ["-m", "scheduler.api.server"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Backend: run pytest",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python3",
    "args": ["-m", "pytest"],
    "cwd": "$ZED_WORKTREE_ROOT/scheduler",
    "use_new_terminal": true
  },
  {
    "label": "Compare: CP-SAT v99 vs Human (June 2026)",
    "command": ".venv/bin/python3",
    "args": [
      "tools/compare_schedules.py",
      "Request-Imports/cpsat-v99.xlsx",
      "Request-Imports/june-human.xlsx",
      "--names", "CP-SAT", "Human"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true
  }
]
